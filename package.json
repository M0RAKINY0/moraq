{
  "name": "moraq",
  "version": "0.0.0",
  "private": true,
  "description": "AI gateway library for Node: one API across LLM providers, with fallbacks, rate limiting and caching.",
  "keywords": [
    "ai",
    "llm",
    "gateway",
    "openai",
    "anthropic",
    "gemini",
    "fallback",
    "rate-limit",
    "cache"
  ],
  "license": "MIT",
  "author": "M0RAKINY0",
  "homepage": "https://github.com/M0RAKINY0/moraq#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/M0RAKINY0/moraq.git"
  },
  "bugs": {
    "url": "https://github.com/M0RAKINY0/moraq/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:redis": "npm run redis:up && vitest run --project redis",
    "test:smoke": "vitest run --project smoke --passWithNoTests",
    "redis:up": "docker compose up -d --wait",
    "redis:down": "docker compose down",
    "build": "tsdown",
    "check:package": "publint && attw --pack . --profile esm-only",
    "size": "size-limit"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.6.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@types/node": "^22.20.5",
    "husky": "^9.1.7",
    "ioredis": "^6.0.0",
    "publint": "^0.3.25",
    "size-limit": "^14.3.0",
    "tsdown": "^0.23.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "size-limit": [
    {
      "path": "dist/index.mjs",
      "limit": "10 kB"
    }
  ]
}
