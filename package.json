{
  "name": "moraq",
  "version": "0.0.0",
  "private": true,
  "description": "AI gateway library for Node: one API across LLM providers, with fallbacks, rate limiting and caching.",
  "keywords": [
    "ai",
    "llm",
    "gateway",
    "openai",
    "anthropic",
    "gemini",
    "fallback",
    "rate-limit",
    "cache"
  ],
  "license": "MIT",
  "author": "M0RAKINY0",
  "homepage": "https://github.com/M0RAKINY0/moraq#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/M0RAKINY0/moraq.git"
  },
  "bugs": {
    "url": "https://github.com/M0RAKINY0/moraq/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:redis": "npm run redis:up && vitest run --project redis",
    "test:smoke": "vitest run --project smoke --passWithNoTests",
    "redis:up": "docker compose up -d --wait",
    "redis:down": "docker compose down"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^22.20.5",
    "husky": "^9.1.7",
    "ioredis": "^6.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
